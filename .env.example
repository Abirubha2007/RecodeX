# ReCodeX - Environment Template
# Copy this file to .env and fill in your values. Never commit .env.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
APP_ENV=development
APP_DEBUG=true

# ─── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── CORS – allowed frontend origins ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","https://your-frontend.onrender.com"]

# ─── Execution provider ───────────────────────────────────────────────────────
# Supported: judge0
EXECUTION_PROVIDER=judge0
# Judge0 self-hosted or RapidAPI endpoint (no trailing slash)
JUDGE0_BASE_URL=
# Leave empty if your Judge0 instance does not require an API key
JUDGE0_API_KEY=

# ─── Optional persistent storage ─────────────────────────────────────────────
# Leave empty to run without a database (stateless MVP mode)
DATABASE_URL=

# ─── Resource and request limits ─────────────────────────────────────────────
EXECUTION_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_KB=100
MAX_OUTPUT_SIZE_KB=256
