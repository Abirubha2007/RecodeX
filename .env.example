# ReCodeX - Environment Template
# Copy this file to .env and fill in your values. Never commit .env.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
APP_ENV=development
APP_DEBUG=true

# ─── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── CORS – allowed frontend origins ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","https://your-frontend.onrender.com"]

# ─── Execution provider ───────────────────────────────────────────────────────
# Supported: onlinecompiler
EXECUTION_PROVIDER=onlinecompiler
# OnlineCompiler.io REST API endpoint
ONLINECOMPILER_BASE_URL=https://api.onlinecompiler.io
# Your OnlineCompiler.io API key (get one free at https://api.onlinecompiler.io)
ONLINECOMPILER_API_KEY=8dbae643d6d44fae34ed33d9d3817d16

# ─── Optional persistent storage ─────────────────────────────────────────────
# Leave empty to run without a database (stateless MVP mode)
DATABASE_URL=

# ─── Resource and request limits ─────────────────────────────────────────────
EXECUTION_TIMEOUT_SECONDS=5
MAX_CODE_SIZE_KB=100
MAX_OUTPUT_SIZE_KB=256
